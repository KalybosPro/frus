{
  "name": "frus",
  "displayName": "frus",
  "description": "Run frus applications on any device from VS Code: a device picker, F5, the application's log in the Debug Console, and reload on save.",
  "version": "0.1.0",
  "publisher": "kalybospro",
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KalybosPro/frus",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "keywords": [
    "frus",
    "rust",
    "ui",
    "android",
    "hot reload"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:Cargo.toml",
    "workspaceContains:*/Cargo.toml",
    "onDebugResolve:frus"
  ],
  "contributes": {
    "commands": [
      {
        "command": "frus.selectDevice",
        "title": "Select Device",
        "category": "frus"
      },
      {
        "command": "frus.reload",
        "title": "Reload",
        "category": "frus",
        "icon": "$(zap)"
      },
      {
        "command": "frus.restart",
        "title": "Restart (state afresh)",
        "category": "frus",
        "icon": "$(debug-restart)"
      },
      {
        "command": "frus.toggleDebugPaint",
        "title": "Toggle Debug Paint",
        "category": "frus"
      },
      {
        "command": "frus.toggleInspector",
        "title": "Toggle Inspector",
        "category": "frus"
      },
      {
        "command": "frus.togglePlatform",
        "title": "Toggle Platform",
        "category": "frus"
      },
      {
        "command": "frus.toggleBrightness",
        "title": "Toggle Brightness",
        "category": "frus"
      },
      {
        "command": "frus.togglePerformanceOverlay",
        "title": "Toggle Performance Overlay",
        "category": "frus"
      },
      {
        "command": "frus.printWidgetTree",
        "title": "Print Widget Tree",
        "category": "frus"
      },
      {
        "command": "frus.printFocusTree",
        "title": "Print Focus Tree",
        "category": "frus"
      },
      {
        "command": "frus.printSemanticsTree",
        "title": "Print Semantics Tree",
        "category": "frus"
      },
      {
        "command": "frus.screenshot",
        "title": "Save Screenshot",
        "category": "frus"
      },
      {
        "command": "frus.detach",
        "title": "Detach (leave the application running)",
        "category": "frus"
      },
      {
        "command": "frus.launchEmulator",
        "title": "Launch Emulator",
        "category": "frus"
      },
      {
        "command": "frus.createEmulator",
        "title": "Create Emulator",
        "category": "frus"
      },
      {
        "command": "frus.runDoctor",
        "title": "Run Doctor",
        "category": "frus"
      }
    ],
    "keybindings": [
      {
        "command": "frus.reload",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "inDebugMode && debugType == 'frus'"
      },
      {
        "command": "frus.restart",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "inDebugMode && debugType == 'frus'"
      }
    ],
    "menus": {
      "debug/toolbar": [
        {
          "command": "frus.reload",
          "when": "debugType == 'frus'",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "frus.reload",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.restart",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.toggleDebugPaint",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.toggleInspector",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.togglePlatform",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.toggleBrightness",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.togglePerformanceOverlay",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.printWidgetTree",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.printFocusTree",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.printSemanticsTree",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.screenshot",
          "when": "inDebugMode && debugType == 'frus'"
        },
        {
          "command": "frus.detach",
          "when": "inDebugMode && debugType == 'frus'"
        }
      ]
    },
    "configuration": {
      "title": "frus",
      "properties": {
        "frus.path": {
          "type": "string",
          "default": "",
          "description": "The `frus` program to use. Empty: the one on the PATH, installed with `cargo install frus-cli` when there is none."
        },
        "frus.reloadOnSave": {
          "type": "string",
          "enum": [
            "never",
            "manual",
            "manualIfDirty",
            "all"
          ],
          "enumDescriptions": [
            "Never reload on save.",
            "Reload when a Rust file is saved by hand (Ctrl+S), not by auto save.",
            "Reload when a Rust file with changes is saved by hand, not by auto save.",
            "Reload on every save of a Rust file, auto save included."
          ],
          "default": "manual",
          "description": "When saving a Rust file reloads the running application, keeping the state of the components that keep one."
        }
      }
    },
    "debuggers": [
      {
        "type": "frus",
        "label": "frus",
        "languages": [
          "rust"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "cwd": {
                "type": "string",
                "description": "The application's directory: where its Cargo.toml is.",
                "default": "${workspaceFolder}"
              },
              "deviceId": {
                "type": "string",
                "description": "Where to run: a device's id as `frus devices` prints it, or `android`, `web`, `desktop`. Empty: the device chosen in the status bar."
              },
              "release": {
                "type": "boolean",
                "description": "A release build.",
                "default": false
              },
              "hot": {
                "type": "boolean",
                "description": "True hot reload, on the desktop: each saved change is patched into the running application, every state kept (frus run --hot).",
                "default": false
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the application (desktop).",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "frus",
            "request": "launch",
            "name": "frus",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "frus: Run",
            "description": "Run a frus application on the selected device",
            "body": {
              "type": "frus",
              "request": "launch",
              "name": "frus",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "test:integration": "tsc -p . && node out/test/integration/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
