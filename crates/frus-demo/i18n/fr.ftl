# Ressources de localisation (français) — démo frus.
app-title = Mes tâches
add = Ajouter
filter-all = Toutes
filter-active = Actives
filter-done = Terminées
# Compteur avec pluriel (en français, 0 et 1 sont au singulier).
task-count = { $n ->
    [0] Aucune tâche
    [one] { $n } tâche
   *[other] { $n } tâches
  }
remaining = { $n ->
    [one] { $n } restante
   *[other] { $n } restantes
  }
