# Localisation resources (French) — frus demo.
app-title = Mes tâches
add = Ajouter
filter-all = Toutes
filter-active = Actives
filter-done = Terminées
# Pluralised counter (in French, 0 and 1 both take the singular).
task-count = { $n ->
    [0] Aucune tâche
    [one] { $n } tâche
   *[other] { $n } tâches
  }
remaining = { $n ->
    [one] { $n } restante
   *[other] { $n } restantes
  }
