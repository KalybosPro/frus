# Localisation resources (English) — frus demo.
app-title = My Tasks
add = Add
filter-all = All
filter-active = Active
filter-done = Done
# Pluralised counter (CLDR rules).
task-count = { $n ->
    [0] No tasks
    [one] { $n } task
   *[other] { $n } tasks
  }
remaining = { $n ->
    [one] { $n } left
   *[other] { $n } left
  }
