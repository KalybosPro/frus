# Ressources de localisation (anglais) — démo frus.
app-title = My Tasks
add = Add
filter-all = All
filter-active = Active
filter-done = Done
# Compteur avec pluriel (règles CLDR).
task-count = { $n ->
    [0] No tasks
    [one] { $n } task
   *[other] { $n } tasks
  }
remaining = { $n ->
    [one] { $n } left
   *[other] { $n } left
  }
